{
  "expo": {
    "name": "MyEventApp",
    "slug": "MyEventApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./app/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.myeventapp",
      "config": {
        "googleMapsApiKey": "AIzaSyC8OxMEXIbnZoXRf2fwUMtBGLWqqkB7lgQ"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "package": "com.yourname.myeventapp",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC8OxMEXIbnZoXRf2fwUMtBGLWqqkB7lgQ"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you upload event banners and profile pictures."
        }
      ],
      "expo-font",
      "expo-video",
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "AIzaSyC8OxMEXIbnZoXRf2fwUMtBGLWqqkB7lgQ",
          "androidGoogleMapsApiKey": "AIzaSyC8OxMEXIbnZoXRf2fwUMtBGLWqqkB7lgQ"
        }
      ]
    ]
  }
}
